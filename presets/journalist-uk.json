{
  "preset": "journalist-uk",
  "language": "uk",
  "desc": "Програма веде пітч-трекер і факт-леджер: нагадує, коли час нагадати редакції про себе, і не дає здати матеріал з неперевіреними твердженнями.",
  "best_for": "Для кого: журналісти й нон-фікшн автори, які працюють із джерелами, редаціями і дедлайнами.",
  "entities": [
    { "name": "джерело", "fields": ["ім'я", "видання", "контакт", "on/off-record"] },
    { "name": "інтерв'ю", "fields": ["дата", "тривалість", "статус"] },
    { "name": "твердження", "fields": ["перевірено", "посилання"] },
    { "name": "пітч", "fields": ["видання", "статус", "дедлайн"] }
  ],
  "structure": {
    "статті": { "матеріал": ["чернетка"] }
  },
  "checklists": [
    { "name": "перед-здачею", "items": ["fact-unverified-check", "усі цитати узгоджені з джерелами", "pitch-статус оновлено", "off-record фрагменти викинуті"] }
  ],
  "validators": {
    "fact-unverified-check": true,
    "pitch-followup": true
  },
  "templates": {
    "pitch-card": "# Пітч: {{title}}\n\n## Видання\n\n## Суть (2 абзаци)\n\n## Чому я\n\n## Чому зараз\n\n## Дедлайн\n",
    "fact-entry": "- **Твердження:** \n  **Джерело:** \n  **Статус:** неперевірене\n  **Де в тексті:** \n"
  }
}
