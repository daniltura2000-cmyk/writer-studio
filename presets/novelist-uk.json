{
  "preset": "novelist-uk",
  "language": "uk",
  "description": "Романіст / вебновел-автор: рукопис, живий story bible, name-drift, канон",
  "entities": [
    { "name": "персонаж", "fields": ["вік", "зовнішність", "арка", "статус"] },
    { "name": "локація", "fields": ["регіон"] },
    { "name": "предмет", "fields": [] },
    { "name": "подія", "fields": ["коли"] }
  ],
  "structure": {
