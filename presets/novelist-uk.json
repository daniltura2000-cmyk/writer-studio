    { "name": "перед-публікація", "items": ["consistency-scan", "name-drift", "timeline"] }
  ],
  "validators": {
    "name-drift": true,
    "assertion-conflict": true
  },
  "templates": {
    "chapter-note": "# {{title}}\n\n## Мета сцени\n\n## Що змінилося в каноні\n"
