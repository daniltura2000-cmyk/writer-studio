{
  "preset": "note-taker-uk",
  "language": "uk",
  "desc": "Програма стежить за вашими нотатками: будує зв'язки між ними, знаходить поламані лінки, сирітські і задавнені нотатки.",
  "best_for": "Для кого: дослідники, студенти й всі, хто веде особисту базу знань у стилі Zettelkasten.",
  "entities": [
    { "name": "концепція", "fields": ["джерело"] },
    { "name": "джерело", "fields": ["автор", "рік"] }
  ],
  "structure": {
    "нотатки": { "тема": ["нотатка"] }
  },
  "checklists": [
    { "name": "оформлення нотатки", "items": ["одна думка", "лінки на джерела"] }
  ],
  "validators": {
    "assertion-conflict": true,
    "broken-links": true,
    "orphan-notes": true,
    "stale-notes": true
  },
  "templates": {
    "daily-note": "---\ntitle: Щоденник {{date}}\ndate: {{date}}\n---\n\n# Щоденник — {{date}}\n\n← [[{{yesterday}}]] · [[{{tomorrow}}]] →\n\n## День\n\n- \n",
    "topic-note": "---\ntitle: {{title}}\ndate: {{date}}\n---\n\n# {{title}}\n\n## Суть (одна думка)\n\n## Джерела\n\n"
  }
}
