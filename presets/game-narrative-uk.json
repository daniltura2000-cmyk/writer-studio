{
  "preset": "game-narrative-uk",
  "language": "uk",
  "desc": "Програма перетворює діалоги на текстові ноди, стежить за barks і змінними та показує, які гілки графа недосяжні чи зламані.",
  "best_for": "Для кого: гейм-наративні дизайнери, які пишуть діалоги для ігор текстом замість таблиць Excel.",
  "entities": [
    { "name": "персонаж", "fields": ["голос", "тон", "репліки-блокери"] },
    { "name": "локація", "fields": ["зона", "рівень"] },
    { "name": "квест", "fields": ["статус", "передумови"] },
    { "name": "bark-тригер", "fields": ["пріоритет", "cooldown"] }
  ],
  "structure": {
    "діалоги": { "документ": ["нода"] },
    "квести": { "квест": ["крок"] }
  },
  "checklists": [
    { "name": "перед-імплементацією", "items": ["var-audit", "graph-audit", "bark-duplicates", "limits-scan"] },
    { "name": "bark-якість", "items": ["10-15 варіантів", "без дублів", "тон персонажа"] }
  ],
  "validators": {
    "name-drift": true,
    "var-orphan-check": true,
    "var-dead-flag": true,
    "graph-unreachable": true,
    "graph-dangling-goto": true,
    "bark-duplicate": true,
    "loc-limits": true
  },
  "templates": {
    "dialogue-node": "-> {{нода}}\n{{персонаж}}: {{репліка}}\n[goto {{наступна}}]\n",
    "bark-sheet": "# {{тригер}}\nумови: {{умови}}\nпріоритет: {{n}}\ncooldown: {{сек}}\n- варіант 1\n- варіант 2\n"
  }
}
